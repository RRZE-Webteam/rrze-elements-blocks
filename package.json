{
	"name": "rrze-elements-blocks",
	"version": "1.3.2",
	"description": "RRZE Elements: Gestalterische Erweiterungen für den BlockEditor",
	"main": "build/index.js",
	"textdomain": "rrze-elements-blocks",
	"license": "GPL-3.0-or-later",
	"private": true,
	"files": [
		"assets/",
		"build/",
		"config/",
		"includes/",
		"languages/",
		"src/_shared/icons/",
		"webfonts/",
		"rrze-elements-blocks.php",
		"readme.md",
		"readme.txt"
	],
	"scripts": {
		"build": "wp-scripts build && sass --style=compressed --no-source-map src/_shared/scss/rrze-elements-blocks.scss assets/css/rrze-elements-blocks.css && sass --style=compressed --no-source-map src/_shared/scss/rrze-elements-blocks-elemental-compatibility.scss assets/css/rrze-elements-blocks-elemental-compatibility.css",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint": "eslint .",
		"lint:fix": "npm run lint -- --fix",
		"typecheck": "tsc --noEmit",
		"test": "composer phpstan",
		"test:js": "node --test tests/js/*.js",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "concurrently \"wp-scripts start\" \"sass --no-source-map src/_shared/scss/rrze-elements-blocks.scss assets/css/rrze-elements-blocks.css -w\" \"sass --no-source-map src/_shared/scss/rrze-elements-blocks-elemental-compatibility.scss assets/css/rrze-elements-blocks-elemental-compatibility.css -w\"",
		"build-all": "node check-compatibility.js && sass --style=compressed --no-source-map src/_shared/scss/rrze-elements-blocks.scss assets/css/rrze-elements-blocks.css && npm run build && npx playwright test",
		"update-version": "node update-version.js && npm run build",
		"test:e2e": "NODE_OPTIONS=--use-system-ca playwright test",
		"minify:carousel:js": "npx google-closure-compiler --js=assets/js/carousel/rrze-carousel.js --js_output_file=assets/js/carousel/rrze-carousel.min.js --compilation_level=SIMPLE --language_out=ECMASCRIPT_2015\n",
		"minify:media-accordion:js": "npx google-closure-compiler --js=assets/js/media-accordion/rrze-media-accordion.js --js_output_file=assets/js/media-accordion/rrze-media-accordion.min.js --compilation_level=SIMPLE --language_out=ECMASCRIPT_2015\n",
		"minify:accordion:js": "npx google-closure-compiler --js=assets/js/accordion/rrze-accordion.js --js_output_file=assets/js/accordion/rrze-accordion.min.js --compilation_level=SIMPLE --language_out=ECMASCRIPT_2015\n",
		"minify:tabs:js": "npx google-closure-compiler --js=assets/js/tabs/rrze-tabs.js --js_output_file=assets/js/tabs/rrze-tabs.min.js --compilation_level=SIMPLE --language_out=ECMASCRIPT_2015\n",
		"minify:counter:js": "npx google-closure-compiler --js=assets/js/counter/rrze-counter.js --js_output_file=assets/js/counter/rrze-counter.min.js --compilation_level=SIMPLE --language_out=ECMASCRIPT_2015\n",
		"minify:timeline:js": "npx google-closure-compiler --js=assets/js/timeline/rrze-timeline.js --js_output_file=assets/js/timeline/rrze-timeline.min.js --compilation_level=SIMPLE --language_out=ECMASCRIPT_2015\n",
		"minify:js": "npm run minify:accordion:js && npm run minify:media-accordion:js && npm run minify:carousel:js && npm run minify:counter:js && npm run minify:tabs:js && npm run minify:timeline:js"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/RRZE-Webteam/rrze-elements",
		"issues": "https://github.com/RRZE-Webteam/rrze-elements/issues",
		"clone": "git+https://github.com/RRZE-Webteam/rrze-elements.git"
	},
	"browserslist": [
		"last 3 years",
		"> 1%",
		"not ie <= 11"
	],
	"supports": {
		"email": "webmaster@fau.de",
		"docs": "https://www.wordpress.rrze.fau.de/plugins/fau-und-rrze-plugins/elements/"
	},
	"author": {
		"name": "RRZE-Webteam <webmaster@fau.de>",
		"url": "https://www.wordpress.rrze.fau.de/person/webmaster"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@babel/preset-env": "^7.29.7",
		"@babel/preset-react": "^7.29.7",
		"@eslint/js": "^9.39.4",
		"@playwright/test": "^1.63.0",
		"@svgr/webpack": "^8.1.0",
		"@types/color": "^4.2.1",
		"@types/lodash": "^4.17.25",
		"@types/node": "^26.6.3",
		"@types/react": "^19.3.0",
		"@types/wordpress__block-editor": "^15.0.6",
		"@types/wordpress__blocks": "^15.17.0",
		"@wordpress/api-fetch": "^7.56.0",
		"@wordpress/babel-plugin-makepot": "^6.56.0",
		"@wordpress/blob": "^4.56.0",
		"@wordpress/blocks": "^15.21.1",
		"@wordpress/components": "^30.9.0",
		"@wordpress/compose": "^8.9.0",
		"@wordpress/data": "^10.56.0",
		"@wordpress/element": "^8.8.0",
		"@wordpress/eslint-plugin": "^27.0.0",
		"@wordpress/i18n": "^6.29.0",
		"@wordpress/icons": "^17.0.0",
		"@wordpress/keycodes": "^4.56.0",
		"@wordpress/notices": "^5.56.0",
		"@wordpress/scripts": "^36.0.0",
		"@wordpress/server-side-render": "^6.32.0",
		"autoprefixer": "^10.6.1",
		"babel-loader": "^10.1.1",
		"baseline-browser-mapping": "^2.11.26",
		"concurrently": "^10.0.5",
		"dotenv": "^18.0.4",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-tsdoc": "^0.5.3",
		"globals": "^17.12.0",
		"google-closure-compiler": "^20260927.0.0",
		"inquirer": "^14.2.2",
		"jsdom": "^30.1.1",
		"prompt": "^1.3.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"sass": "^1.98.0",
		"semver": "^7.8.5",
		"ts-loader": "^9.6.2",
		"typescript": "5.9.3",
		"typescript-eslint": "8.71.0"
	},
	"dependencies": {
		"@wordpress/a11y": "^4.56.0",
		"@wordpress/dataviews": "^19.1.0",
		"@wordpress/shortcode": "^4.56.0",
		"color": "5.0.3",
		"gsap": "^3.15.0",
		"he": "^1.2.0",
		"lodash": "^4.18.1",
		"material-symbols": "^0.47.5",
		"react-error-boundary": "^6.1.6"
	},
	"engines": {
		"node": "^22.22.2 || ^24.15.0 || >=26.0.0"
	}
}
